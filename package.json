{
  "name": "room-planner",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "build": "npm run build --workspace @room-planner/web",
    "dev": "npm run dev --workspace @room-planner/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
